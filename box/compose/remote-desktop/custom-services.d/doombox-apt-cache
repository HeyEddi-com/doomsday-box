#!/usr/bin/env bash
# N150-friendly: sleep all day, sync once per 24h, and flush cache on container stop.
set -uo pipefail
SYNC="/usr/local/bin/doombox-sync-apt-cache"
[[ -x "${SYNC}" ]] || SYNC="/usr/local/share/doombox-desktop-help/doombox-sync-apt-cache.sh"

flush() {
  if [[ -x "${SYNC}" ]]; then
    "${SYNC}" || true
  fi
}

trap 'flush; exit 0' TERM INT

# Init already synced at start. Next run is ~24h later, or on stop.
while true; do
  sleep 86400 &
  wait $! || true
  flush
done
