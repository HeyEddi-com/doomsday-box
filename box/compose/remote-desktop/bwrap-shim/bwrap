#!/usr/bin/env python3
"""Docker-safe bubblewrap shim for glycin/GTK image loaders.

Real bwrap fails in unprivileged containers ("Failed to make / slave"),
which aborts xfce4-session/panel and leaves a blank screen with only a cursor.
We skip sandboxing and exec the intended command (already inside a container).
"""
from __future__ import annotations

import os
import sys


def main() -> int:
    args = sys.argv[1:]
    if not args:
        sys.stderr.write("bwrap-shim: missing command\n")
        return 1

    # Prefer glycin loaders (the usual callers of bwrap in webtop).
    for i, arg in enumerate(args):
        if arg.startswith("/usr/libexec/glycin") and os.access(arg, os.X_OK):
            os.execv(arg, args[i:])

    # Generic: first absolute executable that is not clearly a bind path pair.
    skip_next = False
    path_taking = {
        "--chdir",
        "--ro-bind",
        "--ro-bind-try",
        "--bind",
        "--bind-try",
        "--dev-bind",
        "--dev-bind-try",
        "--symlink",
        "--setenv",
        "--unsetenv",
        "--uid",
        "--gid",
        "--hostname",
        "--size",
        "--perms",
        "--file",
        "--bind-fd",
        "--tmpfs",
        "--dir",
        "--seccomp",
        "--uid-fd",
        "--gid-fd",
        "--info-fd",
        "--json-status-fd",
        "--userns-block-fd",
        "--userns-fd",
        "--pidns-fd",
        "--args",
        "--file-label",
        "--remount-ro",
    }
    i = 0
    while i < len(args):
        arg = args[i]
        if skip_next:
            skip_next = False
            i += 1
            continue
        if arg == "--":
            cmd = args[i + 1 :]
            if not cmd:
                break
            os.execvp(cmd[0], cmd)
        if arg.startswith("--") and "=" not in arg and arg in path_taking:
            # Most of these take 1 arg; bind-style take 2.
            if arg in {
                "--ro-bind",
                "--ro-bind-try",
                "--bind",
                "--bind-try",
                "--dev-bind",
                "--dev-bind-try",
                "--symlink",
                "--setenv",
            }:
                i += 3
                continue
            i += 2
            continue
        if arg.startswith("/") and os.path.isfile(arg) and os.access(arg, os.X_OK):
            os.execv(arg, args[i:])
        i += 1

    sys.stderr.write("bwrap-shim: could not find command in: %r\n" % (args,))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
