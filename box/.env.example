# HeyEddi Doomsday Box — compose env (copy to box/.env)
# Arches: amd64 + arm64 (same compose file)

COMPOSE_PROJECT_NAME=doombox

# Published on the appliance (host nginx can proxy :80 → gateway)
GATEWAY_HTTP_PORT=8080
API_PORT=8090

# Resource defaults (lean N100/N150 / Pi-class)
API_CPUS=0.50
API_MEM=512m
DASHBOARD_CPUS=0.25
DASHBOARD_MEM=128m
GATEWAY_CPUS=0.25
GATEWAY_MEM=64m

# Remote desktop profile (browser full desktop — Cursor host). Default off.
REMOTE_DESKTOP_IMAGE=lscr.io/linuxserver/webtop:ubuntu-xfce
REMOTE_DESKTOP_CPUS=2.0
REMOTE_DESKTOP_MEM=4g
REMOTE_DESKTOP_SHM=1gb
REMOTE_DESKTOP_PUID=1000
REMOTE_DESKTOP_PGID=1000

# API docker control — Settings Enable starts/stops remote-desktop (default on)
DOOMBOX_DOCKER_CONTROL=1
# DOCKER_GID=999

# Storage (host paths; bootstrap creates these)
STORAGE_ROOT=/mnt/storage
DOOMBOX_HOST_STATE=/var/lib/doombox
